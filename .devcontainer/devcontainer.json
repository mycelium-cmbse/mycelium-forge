{
  "name": "Mycelium Forge",
  // Open Dev Containers specification (https://containers.dev/) - not VS Code-proprietary. JetBrains
  // Rider opens this same file via JetBrains Gateway, no separate JetBrains-only config needed.
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "workspaceFolder": "/workspaces/mycelium-forge",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/mycelium-forge,type=bind",
  // The Aspire AppHost (Mycelium.Forge.AppHost) starts Postgres, Garage, Keycloak, the migrator, the
  // seeder and Forge itself. docker-in-docker (not docker-outside-of-docker) gives it a Docker daemon
  // inside this container, so the AppHost's bind-mount paths (/workspaces/...) resolve natively.
  // Start it from inside the container with: dotnet run --project Mycelium.Forge.AppHost
  "features": {
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:2": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Non-root user: the workspace image itself has none (it runs as root by default) - the Claude Code CLI refuses
    // `--dangerously-skip-permissions` when launched as root, so a non-root remote user is what
    // actually makes that flag usable here, not just a hardening nicety.
    // No explicit userUid/userGid: the SDK base image already occupies GID 1000 with its own group,
    // so a hardcoded 1000 collides ("GID '1000' already exists") - "automatic" (the feature's
    // default) picks a free id instead, which is more robust to base-image changes anyway.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "forge"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "forge",
  "postStartCommand": "aspire certs trust --non-interactive",
  // Forge (5000) and Keycloak (8081) are reachable from the host browser. The Aspire dashboard port is
  // random and printed (with its login token) by the AppHost, so the IDE forwards it automatically.
  "forwardPorts": [5000, 8081],
  // `~/.claude.json` lives outside `~/.claude`, so persisting only the `.claude` directory isn't
  // enough on its own - CLAUDE_CONFIG_DIR redirects Claude Code's full state (including that file)
  // into the directory the named volume below actually covers, so login survives container rebuilds.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/forge/.claude",
    "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
  },
  "remoteEnv": {
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/forge/.aspnet/dev-certs/trust"
  },
  "mounts": [
    "source=mycelium-forge-claude-config,target=/home/forge/.claude,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "microsoft-aspire.aspire-vscode",
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
