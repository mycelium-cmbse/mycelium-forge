# Copy to .env.prod, fill in real values, and never commit .env.prod.
#
#   cp .env.prod.example .env.prod

# Image to deploy. Defaults to the GHCR image .github/workflows/container-image.yml publishes on
# every GitHub release.
IMAGE=ghcr.io/mycelium-cmbse/mycelium-forge

# The release tag to deploy, e.g. v0.3.0. Avoid `latest` in production so a deploy is reproducible
# and rolling back to a specific version is just changing this value.
TAG=

# Host port the app listens on.
APP_PORT=8080

# Password for the "forge" Postgres role the migrator uses to apply schema.sql (DDL, plus the
# GRANT/REVOKE statements that provision forge_runtime below). Generate a real value, e.g.
# `openssl rand -base64 32`, and never commit it.
POSTGRES_PASSWORD=

# Password for forge_runtime, the least-privileged runtime Postgres role (only ever gets DELETE
# on Forge.Thing). Provisioned automatically alongside the "forge" role on first Postgres init;
# not yet used by the application itself. Generate a real value, e.g. `openssl rand -base64 32`,
# and never commit it.
FORGE_RUNTIME_PASSWORD=

# Access key for S3-compatible artifact storage (Garage). Generate a real value, e.g.
# `openssl rand -hex 16`, and never commit it.
ARTIFACT_STORE_ACCESS_KEY=

# Secret key for S3-compatible artifact storage (Garage). Generate a real value, e.g.
# `openssl rand -hex 32`, and never commit it.
ARTIFACT_STORE_SECRET_KEY=

# Credentials of the bootstrap Keycloak administrator and password of Keycloak's database role.
# Generate real values, e.g. `openssl rand -base64 32`, and never commit them.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Public URL where Keycloak is exposed to browsers (e.g. https://auth.example.com).
KEYCLOAK_PUBLIC_URL=

# Public URL where Mycelium Forge is exposed to browsers (e.g. https://forge.example.com).
FORGE_PUBLIC_URL=

# Secret of the confidential forge-web OIDC client, shared by Keycloak and the app.
FORGE_CLIENT_SECRET=
