<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Mycelium.Forge.Generator</AssemblyName>
        <RootNamespace>Mycelium.Forge.Generator</RootNamespace>
        <LangVersion>14.0</LangVersion>
        <Company>Starion Group S.A.</Company>
        <Authors>Sam Gerene</Authors>
        <Description>uml4net/Handlebars code-generation pipeline for Mycelium Forge: DTOs and enums generated from the Enterprise Architect model.</Description>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-forge</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="uml4net.HandleBars" Version="8.4.0" />
        <PackageReference Include="uml4net.Reporting" Version="8.6.0" />
        <PackageReference Include="uml4net.xmi.Extensions.EnterpriseArchitect" Version="8.6.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Templates\Uml\*.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
