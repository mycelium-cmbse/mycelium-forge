{
  "$schema": "./forge-entity-behaviors.schema.json",
  "behaviors": [
    {
      "entity": "Address",
      "behaviorType": "ScopeItem",
      "configuration": {
        "OwnerProperty": "Owner",
        "ScopeEntity": "Organization",
        "PersonalManagePermission": "ManageOwnProfile",
        "PlatformManagePermission": "ManageOrganizations",
        "OrgManagePermission": "ManageOrganizationSettings",
        "ReadBypassPermissions": [
          "ViewOrganizationMemberList",
          "ViewAllOrganizations",
          "ViewAllAccounts"
        ]
      }
    },
    {
      "entity": "ProfileLink",
      "behaviorType": "ScopeItem",
      "configuration": {
        "OwnerProperty": "Owner",
        "ScopeEntity": "Organization",
        "PersonalManagePermission": "ManageOwnProfile",
        "PlatformManagePermission": "ManageOrganizations",
        "OrgManagePermission": "ManageOrganizationSettings",
        "ReadBypassPermissions": [
          "ViewOrganizationMemberList",
          "ViewAllOrganizations",
          "ViewAllAccounts"
        ]
      }
    },
    {
      "entity": "PackageVersion",
      "behaviorType": "ParentDelegation",
      "configuration": {
        "ParentEntity": "Package",
        "ParentKey": "Owner",
        "ParentOwnerProperties": [
          "PackageOwner",
          "PackageMaintainer"
        ],
        "CreatePermission": "PublishPackageVersion",
        "DeletePermission": "ErasePackageVersion",
        "StateProperty": "Listed",
        "StateActivePermission": "RelistPackageVersion",
        "StateInactivePermission": "UnlistPackageVersion"
      }
    },
    {
      "entity": "PackageMetaData",
      "behaviorType": "ParentDelegation",
      "configuration": {
        "ParentEntity": "PackageVersion",
        "ParentKey": "Owner",
        "CreatePermission": "PublishPackageVersion",
        "DeletePermission": "DeletePackage"
      }
    },
    {
      "entity": "OrganizationInvitation",
      "behaviorType": "InvitationWorkflow",
      "configuration": {
        "ScopeEntity": "Organization",
        "ScopeRoles": [
          "Administrator"
        ],
        "InviteeProperty": "Target",
        "AdminPermission": "ManageOrganizations"
      }
    },
    {
      "entity": "PackageInvitation",
      "behaviorType": "InvitationWorkflow",
      "configuration": {
        "ScopeEntity": "Package",
        "ScopeRoles": [
          "PackageOwner"
        ],
        "InviteeProperty": "Target",
        "AdminPermission": "ManagePackageTeam"
      }
    },
    {
      "entity": "Package",
      "behaviorType": "OrganizationScope",
      "configuration": {
        "PersonalCreatePermission": "PublishPackageToPersonalScope",
        "OrgCreatePermission": "PublishPackageToOrganizationScope",
        "AdminPermission": "ManageOrganizations",
        "BypassPermissions": [
          "ViewAllOrganizations",
          "ManageOrganizations"
        ],
        "ScopeEntity": "Organization",
        "ScopeMemberProperties": [
          "Member",
          "Administrator"
        ]
      }
    }
  ]
}
