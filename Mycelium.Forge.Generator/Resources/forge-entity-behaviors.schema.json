{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Entity Behaviors Configuration",
  "description": "Schema for configuring specialized entity permission behaviors in Mycelium Forge.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "behaviorType", "configuration"],
        "properties": {
          "entity": {
            "type": "string",
            "description": "The name of the entity class."
          },
          "behaviorType": {
            "type": "string",
            "enum": ["ScopeItem", "ParentDelegation", "InvitationWorkflow", "OrganizationScope"],
            "description": "The behavior type kind."
          },
          "configuration": {
            "type": "object",
            "description": "Configuration settings for the behavior.",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "boolean" },
                { "type": "array", "items": { "type": "string" } }
              ]
            }
          }
        }
      }
    }
  },
  "required": ["behaviors"]
}
