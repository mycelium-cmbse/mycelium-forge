<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Company>Starion Group S.A.</Company>
        <Authors>Sam Gerene</Authors>
        <Description>Test-fixture-driven invocation of Mycelium.Forge.Generator: reads the Forge XMI once and runs each generator against it.</Description>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-forge</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0"/>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.msbuild" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Hand-coded reference output used by ExpectedOutputTestFixture, per the uml4net code
             generation tutorial: https://github.com/STARIONGROUP/uml4net/wiki/Code-Generation-Tutorial.
             Excluded from compilation (they're not C# source for this project, they're golden text
             files that happen to have a .cs extension) and copied next to the test assembly so they
             can be read back at run time. -->
        <Compile Remove="Expected\**\*.cs"/>
        <None Include="Expected\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Expected\**\*.sql">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mycelium.Forge.Generator\Mycelium.Forge.Generator.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AssemblyMetadataAttribute is per-assembly: it must be declared here, in the project that
             reads it back via Assembly.GetExecutingAssembly() (GeneratorSetupFixture), not in
             Mycelium.Forge.Generator - evenif the PackageReferences that define
             $(MyceliumModelForgeXmiPath)/$(MyceliumModelCommonPrimitivesXmiPath) live there. The
             property values themselves flow into this project fine via those packages'
             buildTransitive props, since Mycelium.Forge.Generator may be referenced via ProjectReference. -->

        <PackageReference Include="Mycelium.Model.CommonPrimitives" Version="0.2.0"/>
        <PackageReference Include="Mycelium.Model.Forge" Version="0.2.0"/>
        
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>MyceliumModelForgeXmiPath</_Parameter1>
            <_Parameter2>$(MyceliumModelForgeXmiPath)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>MyceliumModelCommonPrimitivesXmiPath</_Parameter1>
            <_Parameter2>$(MyceliumModelCommonPrimitivesXmiPath)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
