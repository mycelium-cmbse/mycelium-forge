{
  "allOf": [
    {
      "$ref": "./Thing.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "experisAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACCEPTED",
            "REJECTED",
            "REVOKED"
          ]
        }
      },
      "required": [
        "experisAt",
        "status"
      ]
    }
  ]
}