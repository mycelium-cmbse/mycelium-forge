{
  "info": {
    "title": "Mycelium Forge HTTP API",
    "version": "1.0.0",
    "description": "The Forge registry's HTTP API. Every response body is a flat JSON array; every element is {\"@id\": ..., \"@type\": ..., ...own properties}; relationships are never inlined, only {\"@id\": ..., \"@type\": ...} stubs. Authorization is out of scope for this document - no operation below assumes or encodes an authorization rule; every route is shown as though the caller may do everything shown."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "tags": [
    { "name": "Documentation" },
    { "name": "Packages" },
    { "name": "Accounts" },
    { "name": "Organizations" },
    { "name": "Reference Data" },
    { "name": "Forge" }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": ["Documentation"],
        "operationId": "GetOpenApiDocument",
        "summary": "The bundled OpenAPI document (this document merged with the generated component schemas).",
        "responses": {
          "200": {
            "description": "The bundled OpenAPI 3.1 document.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/packages": {
      "get": {
        "tags": ["Packages"],
        "operationId": "SearchPackages",
        "summary": "Search over package metadata.",
        "description": "Free-text search, facets, sort and pagination are deliberately out of scope for this document - an intended move to Solr for search is tracked separately (design.md §12.1). This operation is listed for route-surface completeness only; its query parameters are not yet decided.",
        "parameters": [
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "406": { "$ref": "#/components/responses/NotAcceptable" }
        }
      },
      "put": {
        "tags": ["Packages"],
        "operationId": "PublishPackage",
        "summary": "Publish a package version, atomically.",
        "description": "The request body is a flat array of the Package/PackageVersion/PackageMetaData graph being published, mirroring the response wire format - the same {\"@id\", \"@type\"} objects, cross-referenced by @id rather than nested.",
        "requestBody": { "$ref": "#/components/requestBodies/ThingArray" },
        "responses": {
          "201": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/packages/{scope}/{name}": {
      "get": {
        "tags": ["Packages"],
        "operationId": "GetPackageMetadata",
        "summary": "Manifest, version list, dependency graph and release notes for a package.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" },
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "406": { "$ref": "#/components/responses/NotAcceptable" }
        }
      },
      "patch": {
        "tags": ["Packages"],
        "operationId": "UpdatePackageMetadata",
        "summary": "Partially update a package's own metadata.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/PartialThing" },
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/packages/{scope}/{name}/{version}": {
      "get": {
        "tags": ["Packages"],
        "operationId": "GetPackageVersionMetadata",
        "summary": "Metadata for a single, explicit package version.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" },
          { "$ref": "#/components/parameters/Version" },
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "406": { "$ref": "#/components/responses/NotAcceptable" }
        }
      }
    },
    "/packages/{scope}/{name}/artifact": {
      "get": {
        "tags": ["Packages"],
        "operationId": "DownloadLatestArtifact",
        "summary": "The artefact content of the latest listed, non-prerelease version.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" }
        ],
        "responses": {
          "200": {
            "description": "The artefact's opaque bytes. Exempt from content negotiation (design.md §10.3) - served as application/octet-stream, or the format's own registered media type.",
            "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/packages/{scope}/{name}/{version}/artifact": {
      "get": {
        "tags": ["Packages"],
        "operationId": "DownloadArtifact",
        "summary": "The artefact content of a single, explicit package version.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": {
            "description": "The artefact's opaque bytes. Exempt from content negotiation (design.md §10.3) - served as application/octet-stream, or the format's own registered media type.",
            "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/packages/{scope}/{name}/{version}/unlist": {
      "post": {
        "tags": ["Packages"],
        "operationId": "UnlistPackageVersion",
        "summary": "Unlist a version without deleting its content.",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "$ref": "#/components/parameters/PackageName" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "GetAccount",
        "summary": "An account's profile.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Accounts"],
        "operationId": "UpdateAccount",
        "summary": "Partially update an account's own properties.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/PartialThing" },
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/packages": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "ListAccountPackages",
        "summary": "The packages this account owns or maintains.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/address": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "GetAccountAddress",
        "summary": "An account's billing/postal address.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Accounts"],
        "operationId": "SetAccountAddress",
        "summary": "Set (replace) an account's address.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ThingArray" },
