          { "$ref": "#/components/parameters/IncludeContained" },
          { "$ref": "#/components/parameters/IncludeReferenced" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Accounts"],
        "operationId": "CreateAccountProfileLink",
        "summary": "Add a profile link to an account.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ThingArray" },
        "responses": {
          "201": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/profile-links/{id}": {
      "patch": {
        "tags": ["Accounts"],
        "operationId": "UpdateAccountProfileLink",
        "summary": "Partially update one of an account's profile links.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/ResourceId" }
