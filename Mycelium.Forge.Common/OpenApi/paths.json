      "post": {
        "tags": ["Accounts"],
        "operationId": "CreateInvitation",
        "summary": "Send an OrganizationInvitation or PackageInvitation.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ThingArray" },
        "responses": {
          "201": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/invitations/{id}": {
      "delete": {
        "tags": ["Accounts"],
        "operationId": "RevokeInvitation",
        "summary": "Revoke an invitation this account sent.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/ResourceId" }
