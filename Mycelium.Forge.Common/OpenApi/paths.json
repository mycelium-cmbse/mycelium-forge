  "components": {
    "parameters": {
      "IncludeContained": {
        "name": "include-contained",
        "in": "query",
        "description": "Depth of the breadth-first walk over composite/containment edges (IProperty.IsComposite) from the response's root entity/entities. Contained objects are added as additional sibling nodes in the response array, never inlined.",
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "IncludeReferenced": {
        "name": "include-referenced",
        "in": "query",
        "description": "Depth of the breadth-first walk over plain association edges from the response's root entity/entities. Referenced objects are added as additional sibling nodes in the response array, never inlined.",
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "Scope": {
        "name": "scope",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The owning Account's or Organization's short name."
      },
      "PackageName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The package's short name."
      },
      "Version": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "A SemVer version string."
      },
      "Slug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "An Account's or Organization's short name."
      },
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "AccountId": {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "requestBodies": {
      "ThingArray": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ThingArray" }
          }
        }
      },
      "PartialThing": {
        "description": "Not yet decided: JSON Merge Patch (RFC 7396) vs JSON Patch (RFC 6902), which properties are patchable, and how this reconciles with the generated schemas' own \"every property required\" shape (correct for a full GET representation, not for a partial update).",
        "required": true,
        "content": {
          "application/merge-patch+json": {
            "schema": { "type": "object" }
          }
        }
      }
    },
    "responses": {
      "ThingArray": {
        "description": "A flat array of {\"@id\", \"@type\", ...own properties} objects - one element for a single-resource operation, many for anything that returns more.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ThingArray" }
          }
        }
      },
      "BadRequest": {
        "description": "The request could not be understood or failed validation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "NotFound": {
        "description": "No such resource - or, for a read of a package the caller isn't authorised to see, the same response as a package that doesn't exist (design.md §10.1).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with the resource's current state (e.g. a reference-data delete blocked by a foreign-key reference still pointing at it).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "NotAcceptable": {
        "description": "The Accept header names a media type/schema version this Forge instance doesn't support (design.md §10.3). Never silently falls back to the latest version.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      }
    },
    "schemas": {
      "ThingArray": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/ConcreteThing" }
      },
      "ProblemDetails": {
        "description": "RFC 9457 Problem Details, plus a correlationId extension member (design.md §10.1) so a user-facing error can quote it.",
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri-reference", "description": "Defaults to \"about:blank\" when no more specific URI is registered." },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "correlationId": { "type": "string" }
        },
        "required": ["type", "title", "status", "correlationId"]
      }
    }
  }
}
