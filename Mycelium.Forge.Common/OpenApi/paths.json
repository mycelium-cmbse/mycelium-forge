        }
      },
      "delete": {
        "tags": ["Accounts"],
        "operationId": "DeleteAccountProfileLink",
        "summary": "Remove a profile link from an account.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/ResourceId" }
        ],
        "responses": {
          "204": { "description": "Deleted." },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/keys": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "ListAccountKeys",
        "summary": "An account's API keys.",
        "description": "Never returns a usable secret - only the key's own metadata (name, expiry, last-used, revoked). The secret is shown once, on creation only.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ThingArray" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Accounts"],
        "operationId": "CreateAccountKey",
        "summary": "Issue a new API key for an account.",
        "description": "Not yet decided: the generated APIKey schema's own secretHash property is the stored hash, not a usable credential - the plaintext secret this operation must return exactly once has no schema yet.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ThingArray" },
        "responses": {
          "201": { "$ref": "#/components/responses/ThingArray" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/keys/{id}": {
      "delete": {
        "tags": ["Accounts"],
        "operationId": "DeleteAccountKey",
        "summary": "Revoke an API key.",
        "parameters": [
          { "$ref": "#/components/parameters/Slug" },
          { "$ref": "#/components/parameters/ResourceId" }
        ],
        "responses": {
          "204": { "description": "Revoked." },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{slug}/invitations": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "ListSentInvitations",
