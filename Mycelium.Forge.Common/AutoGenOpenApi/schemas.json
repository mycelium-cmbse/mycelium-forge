          {
            "$ref": "#/components/schemas/Thing"
          },
          {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastUsedAt": {
                "type": "string",
                "format": "date-time"
              },
              "name": {
                "type": "string"
              },
              "permissions": {
                "$ref": "#/components/schemas/ThingReference"
