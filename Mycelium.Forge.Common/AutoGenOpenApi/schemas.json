                    "type": "null"
                  }
                ]
              },
              "ownedOrganizationInvitation": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
                }
              },
              "ownedPackageInvitation": {
                "$ref": "#/components/schemas/ThingReference"
              }
            },
            "required": [
              "apiKey",
              "avatarBlobReference",
              "ownedOrganizationInvitation",
              "ownedPackageInvitation"
            ]
          }
        ]
      },
      "Address": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Thing"
          },
          {
            "type": "object",
            "properties": {
              "addressLine1": {
                "type": "string"
