              "administrator": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
                }
              },
              "country": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
                }
              },
              "description": {
                "type": "string"
