            "$ref": "#/components/schemas/APIKey"
          },
          {
            "$ref": "#/components/schemas/Country"
          },
          {
            "$ref": "#/components/schemas/Forge"
          },
          {
            "$ref": "#/components/schemas/Organization"
          },
          {
            "$ref": "#/components/schemas/OrganizationInvitation"
          },
          {
            "$ref": "#/components/schemas/Package"
