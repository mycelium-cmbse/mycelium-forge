          "propertyName": "@type",
          "mapping": {
            "Account": "#/components/schemas/Account",
            "Address": "#/components/schemas/Address",
            "APIKey": "#/components/schemas/APIKey",
            "Country": "#/components/schemas/Country",
            "Forge": "#/components/schemas/Forge",
            "Organization": "#/components/schemas/Organization",
            "OrganizationInvitation": "#/components/schemas/OrganizationInvitation",
            "Package": "#/components/schemas/Package",
            "PackageInvitation": "#/components/schemas/PackageInvitation",
            "PackageMetaData": "#/components/schemas/PackageMetaData",
            "PackageType": "#/components/schemas/PackageType",
            "PackageVersion": "#/components/schemas/PackageVersion",
            "ProfileLink": "#/components/schemas/ProfileLink",
            "ProfileType": "#/components/schemas/ProfileType"
