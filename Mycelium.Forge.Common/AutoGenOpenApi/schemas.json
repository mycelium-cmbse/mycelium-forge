              "packageType": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
                }
              },
              "profileType": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
                }
              }
