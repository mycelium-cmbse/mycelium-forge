      "Account": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Scope"
          },
          {
            "type": "object",
            "properties": {
              "apiKey": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThingReference"
