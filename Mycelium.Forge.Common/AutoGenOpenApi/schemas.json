              },
              "country": {
                "$ref": "#/components/schemas/ThingReference"
              },
              "locality": {
                "type": "string"
              },
              "postalCode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "region": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "addressLine1",
              "addressLine2",
              "country",
              "locality",
              "postalCode",
              "region"
            ]
          }
        ]
      },
      "APIKey": {
