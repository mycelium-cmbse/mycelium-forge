<!--
    Tailwind CSS build.

    Opt in per project with <UseTailwind>true</UseTailwind>. The standalone Tailwind CLI is a single
    self-contained executable, so the build carries no Node, npm or pnpm dependency.

    The binary is fetched once per version into build/tools/ and its SHA-256 is verified against the
    digest published in the release's sha256sums.txt. Because the digest is checked, the feed itself
    is untrusted: TailwindFeedUrl can be repointed at an internal mirror without weakening anything.

        dotnet build -p:TailwindFeedUrl=https://nexus.internal.mycelium/raw/tailwind ^
                     -p:TailwindReleaseTag=$(TailwindVersion)

    Set -p:UseTailwind=false to skip both the download and the compilation, for example when building
    offline or when wwwroot/css/app.css was produced by an earlier pipeline stage.

    To bump the version, change TailwindVersion and replace all three digests from
    https://github.com/tailwindlabs/tailwindcss/releases/download/v<version>/sha256sums.txt
-->
<Project>

    <PropertyGroup Condition="'$(UseTailwind)' == 'true'">
        <TailwindVersion Condition="'$(TailwindVersion)' == ''">4.3.3</TailwindVersion>
        <TailwindFeedUrl Condition="'$(TailwindFeedUrl)' == ''">https://github.com/tailwindlabs/tailwindcss/releases/download</TailwindFeedUrl>
        <TailwindReleaseTag Condition="'$(TailwindReleaseTag)' == ''">v$(TailwindVersion)</TailwindReleaseTag>
        <TailwindToolsDir>$(MSBuildThisFileDirectory)build/tools/tailwind/$(TailwindVersion)/</TailwindToolsDir>
        <TailwindMinify Condition="'$(Configuration)' == 'Release'">--minify</TailwindMinify>
    </PropertyGroup>

    <!-- The expected digest differs per asset, so it is set alongside the file name rather than as a
         single shared property; one digest cannot validate three platform binaries. The glibc assets
         are selected. A musl-based build image needs the -musl assets and their own digests. -->
    <PropertyGroup Condition="'$(UseTailwind)' == 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
        <TailwindFileName>tailwindcss-windows-x64.exe</TailwindFileName>
        <TailwindExpectedSha256>e0e260ce048014e9268f6237ff18f8ccf02cef521cbd0ae04e82c2cdf7aa3955</TailwindExpectedSha256>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UseTailwind)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))">
        <TailwindFileName>tailwindcss-linux-x64</TailwindFileName>
        <TailwindExpectedSha256>dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a</TailwindExpectedSha256>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UseTailwind)' == 'true' AND $([MSBuild]::IsOSPlatform('OSX'))">
        <TailwindFileName>tailwindcss-macos-arm64</TailwindFileName>
        <TailwindExpectedSha256>cdf646702987a743464dff4d9c60fd4480d1c1e73dd819a9a67f1078815dce9d</TailwindExpectedSha256>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UseTailwind)' == 'true'">
        <TailwindExe>$(TailwindToolsDir)$(TailwindFileName)</TailwindExe>
    </PropertyGroup>

    <Target Name="RestoreTailwind"
            Condition="'$(UseTailwind)' == 'true' AND !Exists('$(TailwindExe)')">
        <Error Condition="'$(TailwindFileName)' == ''"
               Text="No standalone Tailwind CLI asset is mapped for this platform. Add the mapping to Directory.Build.targets, or build with -p:UseTailwind=false."/>

        <MakeDir Directories="$(TailwindToolsDir)"/>

        <DownloadFile SourceUrl="$(TailwindFeedUrl)/$(TailwindReleaseTag)/$(TailwindFileName)"
                      DestinationFolder="$(TailwindToolsDir)"
                      DestinationFileName="$(TailwindFileName)"
                      Retries="3"/>

        <Exec Command="chmod +x &quot;$(TailwindExe)&quot;"
              Condition="!$([MSBuild]::IsOSPlatform('Windows'))"/>

        <GetFileHash Files="$(TailwindExe)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_TailwindHash"/>
        </GetFileHash>

        <!-- Delete the artefact before failing, so a corrupted or tampered download is not treated as
             a valid cache entry by the !Exists() condition on the next build. -->
        <Delete Files="$(TailwindExe)"
                Condition="'%(_TailwindHash.FileHash)' != '$(TailwindExpectedSha256)'"/>

        <Error Condition="'%(_TailwindHash.FileHash)' != '$(TailwindExpectedSha256)'"
               Text="Tailwind CLI checksum mismatch for $(TailwindFileName). Expected $(TailwindExpectedSha256), got %(_TailwindHash.FileHash). The download has been discarded."/>
    </Target>

    <Target Name="BuildTailwind"
            BeforeTargets="Build"
            DependsOnTargets="RestoreTailwind"
            Condition="'$(UseTailwind)' == 'true'">
        <!-- Deliberately not incremental. The output differs between Debug and Release because of the
             minify flag, so Inputs/Outputs would serve a stale file after a configuration switch.
             A full compile of this project takes well under a second. -->
        <Exec Command="&quot;$(TailwindExe)&quot; -i Styles/tailwind.css -o wwwroot/css/app.css $(TailwindMinify)"
              WorkingDirectory="$(MSBuildProjectDirectory)"/>
    </Target>

    <!--
        OpenAPI bundle build.

        Opt in per project with <UseOpenApiBundle>true</UseOpenApiBundle>. Merges three documents into
        one self-contained wwwroot/openapi.json, via the Mycelium.Forge.OpenApiBundler console tool -
        the same shape as DD-08's Tailwind build above: a build-time step producing a gitignored
        artefact, unlike every other generator in this codebase (DTOs, serialisers, the SQL schema,
        schemas.json and paths.json themselves), which is a manually-run, by-hand-reviewed
        regeneration test whose output is committed:
          - Mycelium.Forge.Common/OpenApi/shared.json (hand-authored: info/servers/shared components -
            ProblemDetails, ThingArray, include-contained/include-referenced, the standard error
            responses - none of it derivable from the model)
          - Mycelium.Forge.Common/AutoGenOpenApi/paths.json (generated from the model's containment
            structure)
          - Mycelium.Forge.Common/AutoGenOpenApi/schemas.json (generated component schemas)

        Neither generated file is regenerated here - both are read as already-committed files, the
        same way this target reads shared.json. Only the merge into openapi.json happens at build time.

        Hooked to BeforeTargets="CoreCompile" rather than "Build" (unlike the Tailwind target above):
        Build's BeforeTargets hooks run only after Build's own DependsOnTargets chain - which includes
        CoreCompile - has already completed, so if compilation fails, a BeforeTargets="Build" hook
        never runs at all. Nothing here depends on compiled output, so there is no reason to risk that.
    -->
    <PropertyGroup Condition="'$(UseOpenApiBundle)' == 'true'">
        <OpenApiBundlerProject>$(MSBuildThisFileDirectory)Mycelium.Forge.OpenApiBundler\Mycelium.Forge.OpenApiBundler.csproj</OpenApiBundlerProject>
        <OpenApiSharedDocument>$(MSBuildThisFileDirectory)Mycelium.Forge.Common\OpenApi\shared.json</OpenApiSharedDocument>
        <OpenApiPathsDocument>$(MSBuildThisFileDirectory)Mycelium.Forge.Common\AutoGenOpenApi\paths.json</OpenApiPathsDocument>
        <OpenApiSchemasDocument>$(MSBuildThisFileDirectory)Mycelium.Forge.Common\AutoGenOpenApi\schemas.json</OpenApiSchemasDocument>
        <OpenApiBundleOutput>$(MSBuildProjectDirectory)/wwwroot/openapi.json</OpenApiBundleOutput>
    </PropertyGroup>

    <Target Name="BuildOpenApiBundle"
            BeforeTargets="CoreCompile"
            Condition="'$(UseOpenApiBundle)' == 'true'">
        <Exec Command="dotnet run --project &quot;$(OpenApiBundlerProject)&quot; -c $(Configuration) -- &quot;$(OpenApiSharedDocument)&quot; &quot;$(OpenApiPathsDocument)&quot; &quot;$(OpenApiSchemasDocument)&quot; &quot;$(OpenApiBundleOutput)&quot;"/>
    </Target>

</Project>
