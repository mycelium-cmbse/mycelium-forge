<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Mycelium.Forge</AssemblyName>
        <RootNamespace>Mycelium.Forge</RootNamespace>
        <LangVersion>14.0</LangVersion>
        <Company>Starion Group S.A.</Company>
        <Authors>Sam Gerene</Authors>
        <Description>Mycelium Forge package registry for SysML v2 model libraries. Hosts the public web interface and the Forge HTTP API.</Description>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-forge</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="BlazorBlueprint.Components" Version="3.*" />
        <PackageReference Include="BlazorBlueprint.Primitives" Version="3.*" />
        <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.*" />
        <PackageReference Include="Carter" Version="10.0.0" />
        <PackageReference Include="FluentResults" Version="4.0.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mycelium.Forge.Common\Mycelium.Forge.Common.csproj" />
    </ItemGroup>

    <!-- ==========================================================================================
         Tailwind CSS build.

         Styles/tailwind.css is compiled to wwwroot/css/app.css using the standalone Tailwind CLI,
         which is a single self-contained executable. There is deliberately no Node, npm or pnpm
         dependency: the binary is fetched once per version into .tools/ at the repository root and
         reused across builds.

         Set -p:TailwindEnabled=false to skip the download and the compilation, for example when
         building offline or when wwwroot/css/app.css has been produced by an earlier stage.
         ========================================================================================== -->

    <PropertyGroup>
        <TailwindVersion>v4.3.3</TailwindVersion>
        <TailwindEnabled Condition="'$(TailwindEnabled)' == ''">true</TailwindEnabled>
        <TailwindDirectory>$(MSBuildThisFileDirectory)..\.tools\tailwind\$(TailwindVersion)\</TailwindDirectory>
        <TailwindInput>$(MSBuildThisFileDirectory)Styles\tailwind.css</TailwindInput>
        <TailwindOutput>$(MSBuildThisFileDirectory)wwwroot\css\app.css</TailwindOutput>
    </PropertyGroup>

    <!-- The SDK resolves the portable runtime identifier for the machine running the build, which
         maps one-to-one onto the release asset names published by tailwindlabs/tailwindcss. The
         glibc assets are selected; a musl-based build image would need the -musl variants. -->
    <PropertyGroup Condition="'$(TailwindEnabled)' == 'true'">
        <TailwindAsset Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' == 'win-x64'">tailwindcss-windows-x64.exe</TailwindAsset>
        <TailwindAsset Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' == 'linux-x64'">tailwindcss-linux-x64</TailwindAsset>
        <TailwindAsset Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' == 'linux-arm64'">tailwindcss-linux-arm64</TailwindAsset>
        <TailwindAsset Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' == 'osx-x64'">tailwindcss-macos-x64</TailwindAsset>
        <TailwindAsset Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' == 'osx-arm64'">tailwindcss-macos-arm64</TailwindAsset>
        <TailwindExecutable>$(TailwindDirectory)$(TailwindAsset)</TailwindExecutable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Editing a component can introduce a utility class, so the components are build inputs. -->
        <TailwindSource Include="$(MSBuildThisFileDirectory)Components\**\*.razor"/>
        <TailwindSource Include="$(MSBuildThisFileDirectory)wwwroot\styles\themes\*.css"/>
    </ItemGroup>

    <Target Name="ResolveTailwindCli" Condition="'$(TailwindEnabled)' == 'true'">
        <Error Condition="'$(TailwindAsset)' == ''"
               Text="No standalone Tailwind CLI asset is published for runtime identifier '$(NETCoreSdkPortableRuntimeIdentifier)'. Add the mapping to Mycelium.Forge.csproj, or build with -p:TailwindEnabled=false."/>

        <DownloadFile SourceUrl="https://github.com/tailwindlabs/tailwindcss/releases/download/$(TailwindVersion)/$(TailwindAsset)"
                      DestinationFolder="$(TailwindDirectory)"
                      DestinationFileName="$(TailwindAsset)"
                      SkipUnchangedFiles="true"
                      Retries="3"/>

        <Exec Command="chmod +x &quot;$(TailwindExecutable)&quot;"
              Condition="!$([MSBuild]::IsOSPlatform('Windows'))"/>
    </Target>

    <Target Name="BuildTailwindCss"
            DependsOnTargets="ResolveTailwindCli"
            BeforeTargets="BeforeBuild"
            Condition="'$(TailwindEnabled)' == 'true'"
            Inputs="$(TailwindInput);@(TailwindSource)"
            Outputs="$(TailwindOutput)">
        <Message Importance="high" Text="Compiling $(TailwindInput) to $(TailwindOutput)"/>

        <Exec Command="&quot;$(TailwindExecutable)&quot; --input &quot;$(TailwindInput)&quot; --output &quot;$(TailwindOutput)&quot; --minify"/>
    </Target>

</Project>
