<div class="@(this.GetContainerClass())"
     @ondragenter="@(this.HandleDragEnter)"
     @ondragleave="@(this.HandleDragLeave)"
     @ondrop="@(this.HandleDrop)">
    <InputFile class="absolute inset-0 w-full h-full opacity-0 cursor-pointer disabled:cursor-not-allowed z-10"
               accept="@(string.IsNullOrEmpty(this.Accept) ? null : this.Accept)"
               multiple="@(this.Multiple)"
               disabled="@(this.Disabled)"
               OnChange="@(this.HandleFileChange)"
               @attributes="@(this.AdditionalAttributes)"/>

    <div class="w-11 h-11 rounded-full bg-accent flex items-center justify-center shrink-0">
        <LucideIcon Name="@(this.IconName)"
                    Size="@(this.IconSize)"
                    Class="text-primary shrink-0"/>
    </div>

    <span class="text-md leading-sm font-semibold text-foreground-deep text-center select-none">
        @(this.Title)
    </span>

    <span class="text-12-5 leading-2xs font-normal text-muted-foreground text-center select-none">
        @(this.Subtitle)
    </span>

    <div class="h-8 px-3.5 py-2 rounded-8 bg-primary text-primary-foreground flex items-center justify-center gap-1.5 shadow-xs select-none">
        <span class="text-13 leading-xs font-semibold text-primary-foreground">
            @(this.ButtonText)
        </span>
    </div>
</div>