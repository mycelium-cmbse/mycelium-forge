<div class="flex flex-col gap-4 p-6">
    <BbField Class="w-full flex flex-col gap-1.5">
        <BbFieldLabel For="add-to-project-select"
                      Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
            PROJECT
        </BbFieldLabel>
        <BbFieldContent>
            <ForgeSelect TValue="string"
                         @bind-Value="this.SelectedProject"
                         Items="@(this.Projects)"
                         Id="add-to-project-select"/>
        </BbFieldContent>
    </BbField>

    <BbField Class="w-full flex flex-col gap-1.5">
        <BbFieldLabel For="add-to-project-version-constraint"
                      Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
            VERSION CONSTRAINT
        </BbFieldLabel>
        <BbFieldContent>
            <BbInput Id="add-to-project-version-constraint"
                     @bind-Value="this.VersionConstraint"
                     Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
        </BbFieldContent>
    </BbField>

    <ForgeAlert Variant="ForgeAlertVariant.Secondary"
                Description="Adds a Forge dependency to the project. It becomes available to insert from the Library panel, and appears under Settings > Dependencies."
                IconName="info"
                IconSize="15"
                Class="p-2.5 px-3 rounded-md gap-2"/>

    <div class="pt-2 flex items-center justify-end gap-2.5">
        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCancelClicked)">
            Cancel
        </BbButton>

        <BbButton Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnAddDependencyClicked)">
            <LucideIcon Name="plus"
                        Size="14"
                        Class="shrink-0"/>
            <span>Add dependency</span>
        </BbButton>
    </div>
</div>
