@if (this.Element != null)
{
    <div class="rounded-lg border p-3 flex flex-col gap-2 transition-colors @(this.GetContainerClass()) @(this.Class)">
        <div class="flex items-center justify-between gap-2 w-full">
            <div class="flex items-center gap-2 min-w-0">
                <LucideIcon Name="box"
                            Size="16"
                            Class="@($"{this.GetHeaderClass()} shrink-0")" />
                <span class="text-sm leading-xs font-semibold truncate @(this.GetHeaderClass())">
                    @(this.Element.Name)
                </span>
                <span class="text-2xs leading-3xs text-muted-foreground">
                    @(this.Element.Kind)
                </span>
            </div>

            <ForgeBadge Text="@(this.GetCategoryDisplayName())"
                        Class="@($"shrink-0 {this.GetBadgeClass()}")" />
        </div>

        @if (!string.IsNullOrEmpty(this.Element.AttributeSummary))
        {
            <div class="text-xs leading-2xs text-muted-foreground pt-0.5 border-t border-border/50">
                @(this.Element.AttributeSummary)
            </div>
        }
    </div>
}
