<div class="w-full flex items-center justify-between gap-2 rounded-md @(this.GetContainerClass()) @(this.Class)">
    <code class="font-mono text-sm leading-17 truncate flex-1 select-all @(this.GetTextClass()) @(this.TextClass)">
        @(this.Text)
    </code>
    <ForgeCopyButton Text="@(this.Text)"
                     AriaLabel="@(this.AriaLabel)"
                     IconSize="16"
                     IconClass="text-muted-foreground shrink-0"
                     Class="p-1 shrink-0 cursor-pointer transition-colors focus:outline-none text-muted-foreground hover:text-foreground"
                     OnCopied="@(this.OnCopied)"/>
</div>