<section class="flex flex-col gap-4 w-full @(this.Class)">
    <div class="flex items-center justify-between gap-2 w-full h-6">
        <h2 class="text-xl leading-lg font-semibold text-foreground flex-1">
            @(this.Title)
        </h2>
        @if (!string.IsNullOrEmpty(this.ViewAllHref))
        {
            <BbButton Variant="ButtonVariant.Link"
                      Href="@(this.ViewAllHref)">
                <span>View all</span>
                <LucideIcon Name="arrow-right"
                            Size="14"
                            Class="shrink-0"/>
            </BbButton>
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        @foreach (var package in this.Packages)
        {
            <PackageCard Model="@package"/>
        }
    </div>
</section>