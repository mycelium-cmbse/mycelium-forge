@typeparam TInvitation where TInvitation : IInvitation

<ForgeCard Class="p-5 sm:px-5.5 gap-3.5">
    <div class="flex items-center gap-2.5 w-full">
        <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
            PENDING INVITATIONS
        </span>
    </div>

    <div class="flex flex-col w-full divide-y divide-border">
        @foreach (var invitation in this.Invitations)
        {
            <div @key="invitation.Id"
                 class="flex flex-col sm:flex-row sm:items-center gap-3 py-2.25 w-full">
                <span class="max-w-[280px] shrink-0 text-sm leading-xs font-medium text-foreground truncate min-w-0">
                    @(this.TargetNameSelector(invitation))
                </span>

                <BbBadge Variant="BadgeVariant.Secondary"
                         Class="badge-role text-muted-foreground">
                    @(this.RoleTextSelector(invitation))
                </BbBadge>

                <span class="flex-1 text-xs leading-2xs font-normal text-muted-foreground truncate min-w-0">
                    @(GetExpirationText(invitation))
                </span>

                @if (this.CanManage)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Small"
                              Type="ButtonType.Button"
                              OnClick="() => this.OnResend.InvokeAsync(invitation)"
                              Class="@($"{this.ResendButtonClass} shrink-0")">
                        Resend
                    </BbButton>

                    <BbButton Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Small"
                              Type="ButtonType.Button"
                              OnClick="() => this.OnRevoke.InvokeAsync(invitation)"
                              Class="@($"{this.RevokeButtonClass} shrink-0")">
                        Revoke
                    </BbButton>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(this.AlertDescription))
    {
        <ForgeAlert Variant="ForgeAlertVariant.Default"
                    Description="@(this.AlertDescription)"/>
    }
</ForgeCard>