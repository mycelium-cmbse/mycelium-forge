@inherits LayoutComponentBase

@*
    Static server-side rendered shell. Deliberately free of interactive state: navigation is
    plain anchors and search is a form GET, so the whole page works without a circuit.
*@

<div class="min-h-screen flex flex-col bg-background text-foreground">
    <Header></Header>

    <main class="flex-1 w-full">
        @(this.Body)
    </main>

    <Footer></Footer>
</div>

<BbPortalHost />
<BbToastProvider />
<BbDialogProvider />
