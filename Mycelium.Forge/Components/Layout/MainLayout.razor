@inherits LayoutComponentBase

@*
    Static server-side rendered shell. Deliberately free of interactive state: navigation is
    plain anchors and search is a form GET, so the whole page works without a circuit.
*@

<div class="min-h-screen flex flex-col bg-background text-foreground">
    <Header></Header>

    <main class="flex-1 container mx-auto px-4 py-8">
        @(this.Body)
    </main>

    <footer class="border-t border-border">
        <div class="container mx-auto px-4 py-6 text-sm text-muted-foreground">
            Mycelium Forge &mdash; SysML v2 library registry
        </div>
    </footer>
</div>