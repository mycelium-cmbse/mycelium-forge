<footer class="w-full bg-background border-t border-border py-10 flex flex-col gap-7 select-none">
    <div class="max-w-7xl w-full mx-auto px-6 flex flex-col md:flex-row justify-between gap-10">
        <div class="flex flex-col gap-2.5 max-w-90">
            <ForgeLogo/>
            <p class="text-xs leading-2xs text-muted-foreground">
                The MBSE model and package registry for Mycelium.
            </p>
        </div>

        <div class="flex flex-wrap gap-16">
            <div class="flex flex-col gap-2.5">
                <span class="section-label">
                    DOCS
                </span>
                <a href="@PageRoutes.Documentation.Overview"
                   class="footer-link">
                    Registry
                </a>
                <a href="@PageRoutes.Documentation.Overview"
                   class="footer-link">
                    CLI
                </a>
                <a href="@PageRoutes.Documentation.Overview"
                   class="footer-link">
                    Publishing guide
                </a>
            </div>

            <div class="flex flex-col gap-2.5">
                <span class="section-label">
                    LEGAL
                </span>
                <a href="#"
                   class="footer-link">
                    Terms
                </a>
                <a href="#"
                   class="footer-link">
                    Privacy
                </a>
                <a href="#"
                   class="footer-link">
                    Security
                </a>
            </div>

            <div class="flex flex-col gap-2.5">
                <span class="section-label">
                    COMMUNITY
                </span>
                <a href="#"
                   class="footer-link">
                    Forum
                </a>
                <a href="#"
                   class="footer-link">
                    Support
                </a>
                <a href="#"
                   class="footer-link">
                    Community
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-7xl w-full mx-auto px-6 text-2xs leading-3xs text-muted-foreground">
        @(this.CopyrightText)
    </div>
</footer>