<DialogComponent>
    <ChildContent>
        <BbField Class="w-full flex flex-col gap-1.5"
                 IsInvalid="@(this.ValidationManager.HasError(nameof(this.KeyName)))">
            <BbFieldLabel For="create-api-key-name"
                          Class="form-field-label">
                KEY NAME
            </BbFieldLabel>
            <BbFieldContent>
                <BbInput Id="create-api-key-name"
                         Value="@(this.KeyName)"
                         ValueChanged="@(this.OnKeyNameChanged)"
                         Placeholder="e.g. ci-publish or deploy-runner"
                         Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
            </BbFieldContent>
            <BbFieldError Class="form-field-error"
                          Errors="@(this.ValidationManager[nameof(this.KeyName)])"/>
        </BbField>

        <BbField Class="w-full flex flex-col gap-1.5"
                 IsInvalid="@(this.ValidationManager.HasError(nameof(this.SelectedScope)))">
            <BbFieldLabel For="create-api-key-scope"
                          Class="form-field-label">
                SCOPE
            </BbFieldLabel>
            <BbFieldContent>
                <ForgeSelect TValue="string"
                             Value="@(this.SelectedScope)"
                             ValueChanged="@(this.OnScopeChanged)"
                             Items="@(this.Scopes)"
                             Id="create-api-key-scope"/>
            </BbFieldContent>
            <BbFieldError Class="form-field-error"
                          Errors="@(this.ValidationManager[nameof(this.SelectedScope)])"/>
        </BbField>

        <BbField Class="w-full flex flex-col gap-2">
            <BbFieldLabel Class="form-field-label">
                PERMISSIONS
            </BbFieldLabel>
            <BbFieldContent Class="flex flex-col gap-2">
                @foreach (var permission in this.Permissions)
                {
                    <div @key="permission.Name"
                         class="flex items-center gap-2">
                        <BbCheckbox @bind-Checked="permission.IsGranted"
                                    Id="@($"create-api-key-perm-{permission.Name}")"/>
                        <label for="@($"create-api-key-perm-{permission.Name}")"
                               class="text-sm leading-xs text-foreground-muted cursor-pointer select-none">
                            @(permission.Label)
                        </label>
                    </div>
                }
            </BbFieldContent>
        </BbField>

        <BbField Class="w-full flex flex-col gap-1.5">
            <BbFieldLabel For="create-api-key-expiration"
                          Class="form-field-label">
                EXPIRATION
            </BbFieldLabel>
            <BbFieldContent>
                <ForgeSelect TValue="string"
                             @bind-Value="this.SelectedExpiration"
                             Items="@(this.ExpirationOptionKeys)"
                             Id="create-api-key-expiration"/>
            </BbFieldContent>
        </BbField>
    </ChildContent>
    <Footer>
        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCancelClicked)">
            Cancel
        </BbButton>

        <BbButton Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCreateKeyClicked)">
            Create key
        </BbButton>
    </Footer>
</DialogComponent>