<DialogComponent>
    <ChildContent>
        <BbField Class="w-full flex flex-col gap-1.5"
                 IsInvalid="@(this.ValidationManager.HasError(nameof(this.SelectedProject)))">
            <BbFieldLabel For="migrate-in-bloom-project-select"
                          Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                PROJECT
            </BbFieldLabel>
            <BbFieldContent>
                <ForgeSelect TValue="string"
                             Value="@(this.SelectedProject)"
                             ValueChanged="@(this.OnProjectChanged)"
                             Items="@(this.Projects)"
                             Id="migrate-in-bloom-project-select"/>
            </BbFieldContent>
            <BbFieldError Class="text-2xs leading-3xs text-destructive"
                          Errors="@(this.ValidationManager[nameof(this.SelectedProject)])"/>
        </BbField>

        <BbField Class="w-full flex flex-col gap-1.5"
                 IsInvalid="@(this.ValidationManager.HasError(nameof(this.VersionConstraint)))">
            <BbFieldLabel For="migrate-in-bloom-version-constraint"
                          Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                VERSION CONSTRAINT
            </BbFieldLabel>
            <BbFieldContent>
                <BbInput Id="migrate-in-bloom-version-constraint"
                         Value="@(this.VersionConstraint)"
                         ValueChanged="@(this.OnVersionConstraintChanged)"
                         Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
            </BbFieldContent>
            <BbFieldError Class="text-2xs leading-3xs text-destructive"
                          Errors="@(this.ValidationManager[nameof(this.VersionConstraint)])"/>
        </BbField>

        <ForgeAlert Variant="ForgeAlertVariant.Secondary"
                    Description="Opens the ECSS-E-TM-10-25 migration wizard in Bloom. Mapping ambiguities are resolved there, and nothing is committed until you accept the migration report."
                    IconName="info"
                    IconSize="15"
                    Class="p-2.5 px-3 rounded-md gap-2"/>
    </ChildContent>
    <Footer>
        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCancelClicked)">
            Cancel
        </BbButton>

        <BbButton Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnOpenInBloomClicked)">
            <LucideIcon Name="external-link"
                        Size="14"
                        Class="shrink-0"/>
            <span>Open in Bloom</span>
        </BbButton>
    </Footer>
</DialogComponent>