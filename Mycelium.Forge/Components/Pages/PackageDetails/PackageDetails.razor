@using Mycelium.Forge.Components.Pages.PackageDetails.Tabs
@using Mycelium.Forge.ViewModels.PackageDetails
@using Mycelium.Forge.ViewModels.Rows
@* ------------------------------------------------------------------------------------------------
<copyright file="PackageDetails.razor" company="Starion Group S.A.">

  Copyright 2026 Starion Group S.A.
  SPDX-License-Identifier: Apache-2.0

</copyright>
------------------------------------------------------------------------------------------------ *@
@attribute [Route(PageRoutes.Package)]
@attribute [Route(PageRoutes.PackageTab)]

@if (this.ViewModel.Package == null)
{
    return;
}

<PageTitle>@(this.ViewModel.Package.GetFullName(this.ViewModel.Organization)) &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-background min-h-screen select-none">
<header class="w-full bg-card border-b border-border py-7">
    <div class="page-container flex flex-col gap-3.5">
        <ForgeBreadcrumb Items="@(this.GetBreadcrumbItems())"/>

        <div class="flex flex-wrap items-center gap-2.5 w-full">
            <LucideIcon Name="box"
                        Size="26"
                        Class="text-foreground-muted shrink-0"/>
            <h1 class="text-2xl leading-xl font-semibold text-foreground tracking-tight">
                @(this.ViewModel.Package.GetFullName(this.ViewModel.Organization))
            </h1>
            @if (this.ViewModel.Package.IsVerified)
            {
                <LucideIcon Name="badge-check"
                            Size="20"
                            Class="text-primary shrink-0"/>
            }
            <BbBadge Variant="BadgeVariant.Outline"
                     Class="badge-format">
                @(this.ViewModel.PackageType.Name)
            </BbBadge>
            <BbBadge Variant="BadgeVariant.Secondary"
                     Class="badge-format">
                @(this.ViewModel.SelectedVersion.GetVersion())
            </BbBadge>
            @if (!string.IsNullOrWhiteSpace(this.GetReleaseStatus()))
            {
                <ForgeBadge Text="@(this.GetReleaseStatus())"
                            Class="badge-lifecycle-open"/>
            }
            @if (this.ViewModel.IsUserAdmin)
            {
                <div class="flex-1"></div>

                <BbButton id="package-details-settings-button"
                          Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Href="@(PageRoutes.GetPackageSettingsRoute(this.ViewModel.Organization.ShortName, this.ViewModel.Package.ShortName))"
                          Class="shrink-0">
                    <LucideIcon Name="settings"
                                Size="14"
                                Class="shrink-0"/>
                    <span>Settings</span>
                </BbButton>
            }
        </div>

        <p class="text-md leading-sm text-muted-foreground">
            @(this.ViewModel.Package.Description)
        </p>

        <p class="text-xs leading-2xs text-muted-foreground">
            Published recently by @@@(this.ViewModel.Organization.ShortName) · @(this.ViewModel.Package.License) · @(this.ViewModel.Package.downloadCount) downloads
        </p>

        <PackageDetailsActions Package="@(this.ViewModel.Package)"
                               Organization="@(this.ViewModel.Organization)"
                               SelectedVersion="@(this.ViewModel.SelectedVersion)"
                               IsUserAdmin="@(this.ViewModel.IsUserAdmin)"/>

        <div class="w-full rounded-lg bg-card border border-border grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-border">
            <div class="p-3.5 px-5 flex flex-col items-start gap-0.5">
                <span class="section-label">
                    DOWNLOADS
                </span>
                <span class="text-xl leading-lg font-semibold text-foreground">
                    @(this.ViewModel.Package.downloadCount)
                </span>
            </div>
            <div class="p-3.5 px-5 flex flex-col items-start gap-0.5">
                <span class="section-label">
                    QUALITY
                </span>
                <span class="text-xl leading-lg font-semibold text-foreground">
                    @(this.GetQualityScore())
                </span>
            </div>
            <div class="p-3.5 px-5 flex flex-col items-start gap-0.5">
                <span class="section-label">
                    LATEST
                </span>
                <span class="text-xl leading-lg font-semibold text-foreground">
                    @(this.ViewModel.SelectedVersion.GetVersion())
                </span>
            </div>
            <div class="p-3.5 px-5 flex flex-col items-start gap-0.5">
                <span class="section-label">
                    PUBLISHED
                </span>
                <span class="text-xl leading-lg font-semibold text-foreground">
                    @(this.GetPublishedAgo())
                </span>
            </div>
            <div class="p-3.5 px-5 flex flex-col items-start gap-0.5">
                <span class="section-label">
                    LICENSE
                </span>
                <span class="text-xl leading-lg font-semibold text-foreground">
                    @(this.ViewModel.Package.License)
                </span>
            </div>
        </div>
    </div>
</header>

<div class="w-full bg-background py-7">
    <div class="page-container flex flex-col lg:flex-row items-start gap-8">
        <div class="flex-1 w-full flex flex-col gap-4">
            <div class="w-full h-10 rounded-lg bg-card border border-border flex items-center gap-0.5 p-0.5 overflow-x-auto">
                @foreach (var tab in this.ContentTabs)
                {
                    <a @key="tab"
                       href="@(PageRoutes.GetPackageRoute(this.ViewModel.Organization.ShortName, this.ViewModel.Package.ShortName, tab))"
                       class="@(this.GetContentTabClass(tab))">
                        @(tab.ToUpperCaseFirst())
                    </a>
                }
            </div>

            @if (this.SelectedContentTab == PackageTabConstants.Overview)
            {
                <PackageOverviewTab Package="@(this.ViewModel.Package)"
                                    Version="@(this.ViewModel.SelectedVersion)"/>
            }
            else if (this.SelectedContentTab == PackageTabConstants.Contents)
            {
                <PackageContentsTab Elements="@(this.ViewModel.Elements)"/>
            }
            else if (this.SelectedContentTab == PackageTabConstants.Dependencies)
            {
                <PackageDependenciesTab Dependencies="@(this.ViewModel.Dependencies)"/>
            }
            else if (this.SelectedContentTab == PackageTabConstants.Dependents)
            {
                <PackageDependentsTab Dependents="@(this.ViewModel.Dependents)"/>
            }
            else if (this.SelectedContentTab == PackageTabConstants.Versions)
            {
                <PackageVersionsTab Versions="@(this.ViewModel.Versions)"
                                    MetaDatas="@(this.ViewModel.MetaDatas)"
                                    Organization="@(this.ViewModel.Organization)"
                                    Package="@(this.ViewModel.Package)"/>
            }
            else if (this.SelectedContentTab == PackageTabConstants.Validation)
            {
                <PackageValidationTab Checks="@(this.ViewModel.QualityChecks)"
                                      Version="@(this.ViewModel.SelectedVersion)"/>
            }
        </div>

        <aside class="w-full lg:w-[340px] shrink-0 flex flex-col gap-4">
            <ForgeCard>
                <span class="section-label">
                    METADATA
                </span>

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground">Latest stable</span>
                    <span class="font-medium text-foreground text-right">@(this.ViewModel.SelectedVersion.GetVersion())</span>
                </div>

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground">Published</span>
                    <span class="font-medium text-foreground text-right">@(this.GetPublishedAgo())</span>
                </div>

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground">License</span>
                    <BbBadge Variant="BadgeVariant.Outline"
                             Class="badge-format">
                        @(this.ViewModel.Package.License)
                    </BbBadge>
                </div>

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground">Metamodel</span>
                    <span class="font-medium text-foreground text-right">@(this.ViewModel.PackageType.Name)</span>
                </div>

                @if (this.ViewModel.CurrentMetaData != null)
                {
                    <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                        <span class="text-muted-foreground">Provenance</span>
                        @if (this.ViewModel.CurrentMetaData.MetadataSource == MetadataSource.DeclaredByArtefact)
                        {
                            <BbBadge Variant="BadgeVariant.Secondary"
                                     Class="badge-format">
                                Manifest-declared
                            </BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Outline"
                                     Class="badge-format text-muted-foreground">
                                Publisher-asserted
                            </BbBadge>
                        }
                    </div>
                }

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground min-w-fit">Repository</span>
                    <a href="@(this.ViewModel.Package.RepositoryUrl)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="font-medium text-primary hover:underline text-right truncate">
                        @(this.ViewModel.Package.RepositoryUrl)
                    </a>
                </div>

                <div class="flex items-center justify-between gap-2 text-xs leading-2xs">
                    <span class="text-muted-foreground min-w-fit">Package URL</span>
                    <span class="font-medium text-primary text-right truncate"
                          title="@(this.GetPackageUrl())">
                          @(this.GetPackageUrl())
                    </span>
                </div>
            </ForgeCard>

            <ForgeCard>
                <span class="section-label">
                    QUALITY
                </span>

                <div class="flex items-center justify-between gap-2 text-sm leading-xs">
                    <span class="font-semibold text-foreground">Release validated</span>
                    <span class="font-semibold text-success-vivid">
                        @(this.GetQualityScore())
                    </span>
                </div>

                @foreach (var title in this.ViewModel.QualityChecks.Select(check => check.Title))
                {
                    <div @key="title"
                         class="flex items-center gap-2 text-xs leading-2xs text-foreground-muted">
                        <LucideIcon Name="check"
                                    Size="14"
                                    Class="text-success-vivid shrink-0"/>
                        <span class="flex-1 truncate">
                            @(title)
                        </span>
                    </div>
                }
            </ForgeCard>

            <ForgeCard>
                <span class="section-label">
                    MAINTAINERS
                </span>

                @foreach (var maintainer in this.ViewModel.Maintainers)
                {
                    <div @key="maintainer.Id"
                         class="flex items-center gap-2 h-6.5">
                        <CollaboratorAvatar Name="@(maintainer.Name)"
                                            Size="w-6.5 h-6.5"/>
                        <span class="text-xs leading-2xs font-medium text-foreground flex-1 truncate">
                            @(maintainer.Name)
                        </span>
                        @if (maintainer.IsVerified)
                        {
                            <LucideIcon Name="badge-check"
                                        Size="14"
                                        Class="text-primary shrink-0"/>
                        }
                    </div>
                }
            </ForgeCard>

            <ForgeCard>
                <span class="section-label">
                    TAGS
                </span>

                <div class="flex flex-wrap gap-2">
                    @foreach (var tag in this.ViewModel.Package.Tags)
                    {
                        <BbBadge Variant="BadgeVariant.Secondary"
                                 Class="badge-tag">
                            @(tag)
                        </BbBadge>
                    }
                </div>
            </ForgeCard>
        </aside>
    </div>
</div>
</div>