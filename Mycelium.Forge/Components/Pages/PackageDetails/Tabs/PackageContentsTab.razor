@if (this.Elements == null || this.Elements.Count == 0)
{
    return;
}

<div class="w-full p-6 rounded-lg bg-card border border-border flex flex-col gap-3 @(this.Class)">
    <div class="flex items-center justify-between gap-2 w-full">
        <h2 class="text-lg leading-lg font-semibold text-foreground">
            Contents
        </h2>
        <div class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center gap-1 text-2xs leading-3xs font-medium text-muted-foreground">
            <LucideIcon Name="lock"
                        Size="12"
                        Class="text-slate-500 dark:text-slate-400 shrink-0"/>
            <span>Read-only</span>
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
        @foreach (var kind in this.KindTabs)
        {
            <button type="button"
                    @onclick="() => this.SelectKindTab(kind)"
                    class="cursor-pointer transition-colors px-3 py-1.5 rounded-full text-xs leading-2xs @(this.SelectedKindTab == kind ? "bg-primary/10 border border-primary text-primary font-semibold" : "bg-card border border-border text-slate-700 dark:text-slate-300 hover:bg-muted font-medium")">
                @(kind)
            </button>
        }
    </div>

    <div class="w-full rounded-lg bg-card border border-border flex flex-col divide-y divide-border overflow-hidden mt-1">
        @foreach (var element in this.GetFilteredElements())
        {
            <div class="px-4 py-2.5 flex items-center gap-2.5 text-sm leading-xs">
                <LucideIcon Name="box"
                            Size="16"
                            Class="text-slate-500 dark:text-slate-400 shrink-0"/>
                <span class="font-medium text-foreground">
                    @(element.Name)
                </span>
                <span class="text-2xs leading-3xs text-muted-foreground">
                    @(element.Kind)
                </span>
                <div class="flex-1"></div>
                <span class="text-xs leading-2xs text-muted-foreground shrink-0">
                    @(element.AttributeSummary)
                </span>
            </div>
        }
    </div>
</div>