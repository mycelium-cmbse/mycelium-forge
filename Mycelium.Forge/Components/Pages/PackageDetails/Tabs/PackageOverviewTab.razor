@if (this.Model == null)
{
    return;
}

<div class="w-full p-6 rounded-lg bg-card border border-border flex flex-col gap-3">
    <h2 class="text-xl leading-lg font-semibold text-foreground">
        @(this.Model.Package.Name)
    </h2>
    <p class="text-sm leading-xs text-foreground-muted">
        @(this.Model.ReadmeDescription)
    </p>

    <h3 class="text-md leading-sm font-semibold text-foreground pt-1">
        Contents
    </h3>
    <p class="text-sm leading-xs text-foreground-muted">
        @(this.Model.ReadmeContents)
    </p>

    <h3 class="text-md leading-sm font-semibold text-foreground pt-1">
        Usage
    </h3>
    <div class="w-full p-3 px-3.5 rounded-md bg-docs-code-background font-mono text-sm leading-normal flex flex-col gap-0.5 overflow-x-auto text-docs-code-foreground">
        <span class="select-all">
            @(this.Model.CodeUsageImport)
        </span>
        <span class="select-all">
            @(this.Model.CodeUsageBody)
        </span>
    </div>
</div>