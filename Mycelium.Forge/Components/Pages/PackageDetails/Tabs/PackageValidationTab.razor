@using Mycelium.Forge.Common
@using Mycelium.Forge.Extensions

@if (this.Checks == null || this.Checks.Count == 0)
{
    return;
}

<ForgeCard Class="p-6 gap-3">
    <div class="w-full p-3 px-4 rounded-lg bg-success-subtle border border-docs-callout-tip-border flex items-center gap-2.5">
        <LucideIcon Name="check-circle-2"
                    Size="18"
                    Class="text-success-vivid shrink-0"/>
        <div class="flex-1 flex flex-col gap-0.5">
            <span class="text-base leading-normal font-semibold text-success-strong">
                @(this.Checks.All(check => check.Passed) ? "Release validation passed" : "Release validation issues")
            </span>
            <span class="text-xs leading-2xs text-foreground-muted">
                @($"{this.Version.GetVersion()} loaded and resolved cleanly in a fresh workspace.")
            </span>
        </div>
        <span class="text-md leading-sm font-semibold text-success-vivid shrink-0">
            @($"{this.Checks.Count(check => check.Passed)} / {this.Checks.Count}")
        </span>
    </div>

    <div class="w-full rounded-lg bg-card border border-border overflow-hidden mt-1">
        <BlazorBlueprint.Primitives.Table.BbTable TData="object"
                                                  Data="@(this.Checks.Cast<object>())"
                                                  class="w-full text-left text-xs leading-2xs">
            <BlazorBlueprint.Primitives.Table.BbTableBody class="divide-y divide-border">
                @foreach (var check in this.Checks)
                {
                    <BlazorBlueprint.Primitives.Table.BbTableRow TData="object"
                                                                 @key="check.Title"
                                                                 class="px-4 py-3 flex items-center gap-2.5 hover:bg-muted/50 transition-colors">
                        <BlazorBlueprint.Primitives.Table.BbTableCell class="flex items-center gap-2.5 flex-1 p-0">
                            <LucideIcon Name="check"
                                        Size="16"
                                        Class="text-success-vivid shrink-0"/>
                            <div class="flex-1 flex flex-col gap-0.5">
                                <span class="text-sm leading-xs font-semibold text-foreground">
                                    @(check.Title)
                                </span>
                                <span class="text-xs leading-2xs text-muted-foreground">
                                    @(check.Detail)
                                </span>
                            </div>
                        </BlazorBlueprint.Primitives.Table.BbTableCell>
                        <BlazorBlueprint.Primitives.Table.BbTableCell class="text-xs leading-2xs font-medium text-success-vivid shrink-0 p-0">
                            @(check.Passed ? "Pass" : "Fail")
                        </BlazorBlueprint.Primitives.Table.BbTableCell>
                    </BlazorBlueprint.Primitives.Table.BbTableRow>
                }
            </BlazorBlueprint.Primitives.Table.BbTableBody>
        </BlazorBlueprint.Primitives.Table.BbTable>
    </div>
</ForgeCard>
