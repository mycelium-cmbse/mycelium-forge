@if (this.Licenses == null || this.Licenses.Count == 0)
{
    <ForgeCard Class="p-6 gap-2">
        <h2 class="text-lg leading-lg font-semibold text-foreground">
            Licenses
        </h2>
        <p class="text-xs leading-2xs text-muted-foreground">
            No licenses declared for this release.
        </p>
    </ForgeCard>

    return;
}

<ForgeCard Class="p-6 gap-4">
    <div class="flex flex-col gap-1">
        <h2 class="text-lg leading-lg font-semibold text-foreground">
            Licenses
        </h2>
        <p class="text-xs leading-2xs text-muted-foreground">
            @($"{this.Licenses.Count} {(this.Licenses.Count == 1 ? "license" : "licenses")} declared for this release.")
        </p>
    </div>

    <div class="flex flex-col gap-4">
        @foreach (var license in this.Licenses)
        {
            <div @key="license.Id"
                 id="@(license.SpdxIdentifier)"
                 class="w-full rounded-lg bg-background border border-border p-4 flex flex-col gap-3 scroll-mt-6">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-sm leading-xs font-semibold text-foreground">
                        @(license.Name)
                    </span>
                    <BbBadge Variant="BadgeVariant.Outline"
                             Class="badge-format shrink-0">
                        @(license.SpdxIdentifier)
                    </BbBadge>
                </div>

                <pre class="max-h-96 w-full overflow-y-auto whitespace-pre-wrap rounded-md bg-card border border-border p-3.5 font-mono text-xs leading-normal text-foreground-muted select-text">@(license.LicenseText)</pre>
            </div>
        }
    </div>
</ForgeCard>
