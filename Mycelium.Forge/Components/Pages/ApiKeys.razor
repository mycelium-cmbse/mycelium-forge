@using BlazorBlueprint.Primitives.Table
@attribute [Route(PageRoutes.ApiKeys)]

<PageTitle>API Keys &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-body-bg min-h-screen py-10 select-none">
    <div class="page-container flex flex-col gap-5">
        <div class="flex flex-row items-center gap-3">
            <div class="flex flex-col gap-1 flex-1">
                <h1 class="text-3xl leading-3xl font-semibold text-foreground">API keys</h1>
                <p class="text-sm leading-17 text-muted-foreground">
                    Tokens for publishing from the CLI or CI. Read access to public packages requires no key.
                </p>
            </div>
            <BbButton Variant="ButtonVariant.Default"
                      Type="ButtonType.Button"
                      OnClick="@(this.OnCreateKey)"
                      Class="shrink-0">
                <LucideIcon Name="plus"
                            Size="16"
                            Class="shrink-0"/>
                <span>Create key</span>
            </BbButton>
        </div>

        <div class="w-full p-3.5 px-4 rounded-lg bg-info border border-info-border/50 flex flex-row items-start gap-2.5">
            <LucideIcon Name="info"
                        Size="16"
                        Class="text-info-icon shrink-0 mt-0.5"/>
            <div class="flex flex-col gap-0.5 flex-1">
                <span class="text-sm leading-xs font-semibold text-info-foreground">
                    Publishing from CI? Prefer trusted publishing (OIDC).
                </span>
                <p class="text-xs leading-2xs font-normal text-secondary-text">
                    GitHub Actions and GitLab CI can exchange a short-lived token at publish time, so no long-lived secret lives in your repository.
                </p>
            </div>
            <a href="@PageRoutes.Docs"
               class="text-sm leading-xs font-semibold text-info-icon hover:underline shrink-0">
                Configure
            </a>
        </div>

        @if (this.ViewModel.ApiKeys.Count > 0)
        {
            <div class="w-full rounded-lg bg-card border border-border overflow-hidden">
                <BbTable Data="@(this.ViewModel.ApiKeys)"
                         Class="w-full text-left text-sm leading-xs">
                    <BbTableHeader Class="px-5 py-3 bg-muted border-b border-border flex items-center text-2xs leading-3xs font-semibold text-muted-foreground uppercase tracking-wider">
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[210px] shrink-0 p-0 text-left font-semibold">
                            NAME
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[140px] shrink-0 p-0 text-left font-semibold">
                            SCOPE
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[200px] shrink-0 p-0 text-left font-semibold">
                            PERMISSIONS
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[130px] shrink-0 p-0 text-left font-semibold">
                            CREATED
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[150px] shrink-0 p-0 text-left font-semibold">
                            EXPIRES
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[160px] shrink-0 p-0 text-left font-semibold">
                            LAST USED
                        </BbTableHeaderCell>
                        <BbTableHeaderCell TData="APIKey"
                                           Class="w-[90px] shrink-0 p-0 text-left font-semibold">
                        </BbTableHeaderCell>
                    </BbTableHeader>
                    <BbTableBody Class="divide-y divide-border">
                        @foreach (var key in this.ViewModel.ApiKeys)
                        {
                            <BbTableRow @key="key.Id"
                                        Item="@key"
                                        Class="px-5 py-3.5 flex items-center hover:bg-muted/50 transition-colors">
                                <BbTableCell Class="w-[210px] shrink-0 p-0 font-semibold text-sm leading-xs text-foreground truncate">
                                    @(key.Name)
                                </BbTableCell>
                                <BbTableCell Class="w-[140px] shrink-0 p-0 font-medium text-sm leading-xs text-secondary-text truncate">
                                    &#64;starion
                                </BbTableCell>
                                <BbTableCell Class="w-[200px] shrink-0 p-0 font-normal text-xs leading-2xs text-secondary-text truncate">
                                    publish
                                </BbTableCell>
                                <BbTableCell Class="w-[130px] shrink-0 p-0 font-normal text-sm leading-xs text-muted-foreground">
                                    @(key.CreatedAt.ToString("MMM yyyy"))
                                </BbTableCell>
                                <BbTableCell Class="w-[150px] shrink-0 p-0 font-normal text-sm leading-xs text-secondary-text">
                                    @(key.ExpiresAt.ToString("MMM yyyy"))
                                </BbTableCell>
                                <BbTableCell Class="w-[160px] shrink-0 p-0 font-normal text-sm leading-xs text-muted-foreground">
                                    @(key.LastUsedAt == default ? "never" : key.LastUsedAt.ToString("MMM yyyy"))
                                </BbTableCell>
                                <BbTableCell Class="w-[90px] shrink-0 p-0 text-left">
                                    <BbButton Variant="ButtonVariant.Link"
                                              OnClick="() => this.OnRevokeKey(key.Id)"
                                              Class="text-destructive">
                                        Revoke
                                    </BbButton>
                                </BbTableCell>
                            </BbTableRow>
                        }
                    </BbTableBody>
                </BbTable>
            </div>
        }
        else
        {
            <BbEmpty Title="No API keys yet"
                     Description="Generate an API key to publish packages from the command-line interface or continuous integration pipelines."
                     Size="EmptySize.Large"
                     Class="w-full rounded-xl bg-card border border-border py-20">
                <Icon>
                    <div class="icon-circle-primary w-15 h-15">
                        <LucideIcon Name="key-round"
                                    Size="28"
                                    Class="text-primary shrink-0"/>
                    </div>
                </Icon>
                <ChildContent>
                    <BbButton Variant="ButtonVariant.Default"
                              Type="ButtonType.Button"
                              OnClick="@(this.OnCreateKey)"
                              Class="mt-0.5">
                        <LucideIcon Name="plus"
                                    Size="16"
                                    Class="shrink-0"/>
                        <span>Create key</span>
                    </BbButton>
                </ChildContent>
            </BbEmpty>
        }
    </div>
</div>