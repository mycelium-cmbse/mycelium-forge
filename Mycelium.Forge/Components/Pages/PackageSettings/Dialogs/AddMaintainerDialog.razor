<DialogComponent>
    <ChildContent>
        <p class="text-sm leading-xs text-muted-foreground">
            Invite a collaborator to help maintain this package. They will receive a notification and can accept or decline the invitation.
        </p>

        <BbField Class="w-full flex flex-col gap-1.5"
                 IsInvalid="@(this.ValidationManager.HasError(nameof(this.TargetAccount)))">
            <BbFieldLabel For="add-maintainer-target-input"
                          Class="form-field-label">
                Username
            </BbFieldLabel>
            <BbFieldContent>
                <BbInput Id="add-maintainer-target-input"
                         Value="@(this.TargetAccount)"
                         ValueChanged="@(this.OnTargetAccountChanged)"
                         Placeholder="e.g. johndoe"
                         Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
            </BbFieldContent>
            <BbFieldError Class="form-field-error"
                          Errors="@(this.ValidationManager[nameof(this.TargetAccount)])"/>
        </BbField>

        <BbField Class="w-full flex flex-col gap-1.5">
            <BbFieldLabel For="add-maintainer-role-select"
                          Class="form-field-label">
                Role
            </BbFieldLabel>
            <BbFieldContent>
                <ForgeSelect TValue="PackageInvitationKind"
                             Value="@(this.SelectedRole)"
                             ValueChanged="@(this.OnRoleChanged)"
                             Items="@(this.RoleOptions)"
                             DisplayTextSelector="@(role => role.ToUpperCaseFirst())"
                             Id="add-maintainer-role-select"/>
            </BbFieldContent>
        </BbField>
    </ChildContent>
    <Footer>
        <BbButton id="add-maintainer-cancel-button"
                  Variant="ButtonVariant.Outline"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCancelClicked)">
            Cancel
        </BbButton>

        <BbButton id="add-maintainer-submit-button"
                  Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnInviteClicked)">
            Send invitation
        </BbButton>
    </Footer>
</DialogComponent>