@using Mycelium.Forge.Components.Common
@attribute [Route(PageRoutes.SignUp)]
@attribute [Route("/register")]
@rendermode InteractiveServer

<PageTitle>Sign Up &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-body-bg min-h-[calc(100vh-3.5rem)] flex flex-col items-center justify-center py-10 px-4 select-none">
    <div class="auth-card">
        <ForgeLogo/>

        <div class="flex flex-col items-center gap-1 w-full text-center">
            <h1 class="text-xl sm:text-2xl leading-xl font-semibold text-foreground tracking-tight">
                Create your Forge account
            </h1>
            <p class="text-sm leading-xs font-normal text-muted-foreground">
                Publish and reuse MBSE models and packages.
            </p>
        </div>

        <div class="flex flex-col gap-1.5 w-full">
            <BbLabel For="signup-username"
                     Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                USERNAME
            </BbLabel>
            <BbInput Id="signup-username"
                     Type="InputType.Text"
                     Value="@(this.ViewModel.Username)"
                     ValueChanged="@(this.OnUsernameChanged)"
                     Placeholder="e.g. r.andre"
                     Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
        </div>

        <div class="flex flex-col gap-1.5 w-full">
            <BbLabel For="signup-email"
                     Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                EMAIL
            </BbLabel>
            <BbInput Id="signup-email"
                     Type="InputType.Email"
                     Value="@(this.ViewModel.Email)"
                     ValueChanged="@(this.OnEmailChanged)"
                     Placeholder="e.g. name@organisation.eu"
                     Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
            <span class="text-2xs leading-3xs font-normal text-muted-foreground">
                Installation-unique username and a verified email address are required.
            </span>
        </div>

        <div class="flex flex-col gap-1.5 w-full">
            <BbLabel For="signup-password"
                     Class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                PASSWORD
            </BbLabel>
            <BbInput Id="signup-password"
                     Type="InputType.Password"
                     Value="@(this.ViewModel.Password)"
                     ValueChanged="@(this.OnPasswordChanged)"
                     Placeholder="••••••••"
                     Class="h-10 w-full px-3 rounded-md bg-card border border-border text-sm leading-xs text-foreground focus:outline-none"/>
        </div>

        <BbButton Variant="ButtonVariant.Default"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnCreateAccount)"
                  Class="w-full">
            Create account
        </BbButton>

        <div class="callout-warning">
            We will send a verification message. Publishing and package-role assignment stay disabled until your address is verified.
        </div>

        <div class="flex items-center gap-2.5 w-full">
            <div class="flex-1 h-px bg-border"></div>
            <span class="text-2xs leading-3xs font-normal text-muted-foreground">or</span>
            <div class="flex-1 h-px bg-border"></div>
        </div>

        <BbButton Variant="ButtonVariant.Outline"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnContinueWithSso)"
                  Class="w-full">
            Continue with your organisation identity provider
        </BbButton>

        <div class="flex items-center gap-1.5 text-xs leading-2xs font-normal text-muted-foreground pt-0.5">
            <span>Already have an account?</span>
            <a href="@PageRoutes.Login"
               class="text-primary font-medium hover:underline">
                Sign in
            </a>
        </div>
    </div>
</div>