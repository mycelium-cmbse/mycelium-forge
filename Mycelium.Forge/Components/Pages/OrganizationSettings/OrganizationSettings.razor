@attribute [Route(PageRoutes.OrganizationSettings)]
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(false))

@if (this.ViewModel.Organization == null || !this.ViewModel.CanManageOrganization)
{
    return;
}

<PageTitle>@(this.ViewModel.Organization.ShortName) Settings &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-background min-h-screen py-9 select-none">
    <div class="max-w-[1000px] w-full mx-auto px-6 flex flex-col gap-4.5">
        <ForgeBreadcrumb Items="@(this.GetBreadcrumbItems())"/>

        <div class="flex items-center gap-3 w-full">
            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0 text-primary-foreground text-2xs leading-3xs font-semibold">
                @(this.ViewModel.Organization.Name.GetInitials())
            </div>

            <h1 class="text-2xl leading-xl font-semibold text-foreground tracking-tight flex-1 truncate">
                @(this.ViewModel.Organization.ShortName)
            </h1>

            <BbBadge Variant="BadgeVariant.Secondary"
                     Class="badge-role text-primary">
                @(this.ViewModel.CurrentUserRole)
            </BbBadge>
        </div>

        <p class="text-sm leading-xs font-normal text-muted-foreground w-full">
            @(this.ViewModel.Organization.Name) &middot; @(this.ViewModel.Organization.Origin)
        </p>

        <ForgeCard Class="p-5 sm:px-5.5 gap-3.5">
            <div class="flex items-center justify-between gap-2 w-full h-8">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    MEMBERS
                </span>
                <BbButton id="org-settings-transfer-button"
                          Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Type="ButtonType.Button"
                          OnClick="@(this.OnTransferOrganization)"
                          Class="btn-destructive-outline shrink-0">
                    Transfer
                </BbButton>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                @foreach (var member in this.ViewModel.Members)
                {
                    <div class="flex items-center gap-3 py-2.25 w-full" @key="member.Id">
                        <CollaboratorAvatar Name="@(member.Name)"
                                            Size="w-7 h-7"/>

                        <div class="flex-1 flex flex-col justify-center gap-0.5 min-w-0">
                            <span class="text-sm leading-xs font-medium text-foreground truncate">
                                @(member.Name)
                            </span>
                            <span class="text-xs leading-2xs font-normal text-muted-foreground truncate">
                                @(member.ShortName)
                            </span>
                        </div>

                        <div class="w-[230px] shrink-0">
                            <ForgeSelect TValue="OrganizationInvitationKind"
                                         Value="@(this.GetMemberRole(member))"
                                         ValueChanged="@(role => this.OnChangeMemberRole(member, role))"
                                         Disabled="@(this.IsCurrentUser(member))"
                                         Items="@(this.ViewModel.RoleOptions)"
                                         DisplayTextSelector="@(role => role.ToUpperCaseFirst())"
                                         TriggerClass="!h-7 !px-2.5 !py-1 !text-xs !leading-2xs !gap-1.5"
                                         ItemClass="!text-xs !leading-2xs"/>
                        </div>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnRemoveMember(member)"
                                  Class="org-remove-member-button shrink-0">
                            Remove
                        </BbButton>
                    </div>
                }
            </div>

            <p class="text-xs leading-2xs text-muted-foreground w-full">
                An Organization must keep at least one Organization Administrator. The Organization Administrator role takes effect only once the recipient accepts it.
            </p>
        </ForgeCard>

        <ForgeCard Class="p-5 sm:px-5.5 gap-3.5">
            <div class="flex items-center gap-2.5 w-full">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    PENDING INVITATIONS
                </span>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                @foreach (var invitation in this.ViewModel.PendingInvitations)
                {
                    <div @key="invitation.Id"
                         class="flex flex-col sm:flex-row sm:items-center gap-3 py-2.25 w-full">
                        <span class="w-[280px] shrink-0 text-sm leading-xs font-medium text-foreground truncate min-w-0">
                            @(invitation.Target)
                        </span>

                        <BbBadge Variant="BadgeVariant.Secondary"
                                 Class="badge-role text-muted-foreground">
                            @(invitation.OrganizationInvitationKind)
                        </BbBadge>

                        <span class="flex-1 text-xs leading-2xs font-normal text-muted-foreground truncate min-w-0">
                            Expires in @(invitation.ExperiesAt.ToTimeToCome())
                        </span>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnResendInvitation(invitation)"
                                  Class="org-resend-invitation-button shrink-0">
                            Resend
                        </BbButton>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnRevokeInvitation(invitation)"
                                  Class="org-revoke-invitation-button shrink-0">
                            Revoke
                        </BbButton>
                    </div>
                }
            </div>

            <ForgeAlert Variant="ForgeAlertVariant.Default"
                        Description="An invitation admits an Account only after explicit acceptance, and expires automatically."/>
        </ForgeCard>

        <ForgeCard Class="p-5 sm:px-5.5 gap-3.5">
            <div class="flex items-center gap-2.5 w-full">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    SCOPE
                </span>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                <div class="flex items-center justify-between gap-3 py-2 w-full">
                    <span class="text-sm leading-xs font-normal text-foreground-muted truncate min-w-0">
                        Packages published under @(this.ViewModel.Organization.ShortName)
                    </span>
                    <span class="text-sm leading-xs font-medium text-foreground shrink-0">
                        @(this.ViewModel.Organization.OwnedPackage.Count)
                    </span>
                </div>
            </div>

            <p class="text-xs leading-2xs text-muted-foreground w-full">
                The organization cannot be deleted while its scope still holds packages.
            </p>
        </ForgeCard>
    </div>
</div>