@attribute [Route(PageRoutes.OrganizationSettings)]
@rendermode InteractiveServer

@if (this.ViewModel.Organization == null)
{
    return;
}

<PageTitle>@(this.ViewModel.Organization.Scope) Settings &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-body-bg min-h-screen py-9 select-none">
    <div class="max-w-[1000px] w-full mx-auto px-6 flex flex-col gap-4.5">
        <nav class="flex items-center gap-1.5 text-xs leading-2xs">
            <a href="@PageRoutes.Packages"
               class="text-primary hover:underline font-normal">
                Browse
            </a>
            <span class="text-muted-foreground font-normal">/</span>
            <a href="@($"/organizations/{this.ViewModel.Organization.Scope.TrimStart('@')}")"
               class="text-primary hover:underline font-normal">
                @(this.ViewModel.Organization.Scope)
            </a>
            <span class="text-muted-foreground font-normal">/</span>
            <span class="text-muted-foreground font-normal">
                ECSS-MM-PWR
            </span>
        </nav>

        <div class="flex items-center gap-3 w-full">
            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0 text-white text-2xs leading-3xs font-semibold">
                @(this.ViewModel.Organization.Initials)
            </div>

            <h1 class="text-2xl leading-xl font-semibold text-foreground tracking-tight flex-1 truncate">
                @(this.ViewModel.Organization.Scope)
            </h1>

            <BbBadge Variant="BadgeVariant.Secondary"
                     Class="badge-role text-primary">
                @(this.ViewModel.CurrentUserRole)
            </BbBadge>
        </div>

        <p class="text-sm leading-xs font-normal text-muted-foreground w-full">
            @(this.ViewModel.Organization.Name) &middot; @(this.ViewModel.Organization.Description)
        </p>

        <div class="w-full p-5 sm:px-5.5 rounded-lg bg-card border border-border flex flex-col gap-3.5">
            <div class="flex items-center justify-between gap-2 w-full h-8">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    MEMBERS
                </span>
                <BbButton Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Type="ButtonType.Button"
                          OnClick="@(this.OnTransferOrganization)"
                          Class="btn-destructive-outline shrink-0">
                    Transfer
                </BbButton>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                @foreach (var member in this.ViewModel.Members)
                {
                    <div class="flex items-center gap-3 py-2.25 w-full">
                        <div class="w-7 h-7 rounded-full bg-org-member-avatar-bg flex items-center justify-center shrink-0 text-white text-2xs leading-3xs font-semibold">
                            @(member.Initials)
                        </div>

                        <div class="flex-1 flex flex-col justify-center gap-0.5 min-w-0">
                            <span class="text-sm leading-xs font-medium text-foreground truncate">
                                @(member.Name)
                            </span>
                            <span class="text-xs leading-2xs font-normal text-muted-foreground truncate">
                                @(member.Username)
                            </span>
                        </div>

                        <div class="w-[230px] shrink-0">
                            <BlazorBlueprint.Primitives.Select.BbSelect TValue="OrganizationInvitationKind"
                                                                        Value="@member.Role"
                                                                        ValueChanged="@(role => this.OnChangeMemberRole(member, role))">
                                <BlazorBlueprint.Primitives.Select.BbSelectTrigger class="w-full h-7 px-2.5 py-1 rounded-md bg-card border border-border flex items-center justify-between gap-1.5 text-foreground text-xs leading-2xs font-normal focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer">
                                    <span class="truncate">@member.Role</span>
                                    <LucideIcon Name="chevron-down"
                                                Size="12"
                                                Class="text-muted-foreground shrink-0"/>
                                </BlazorBlueprint.Primitives.Select.BbSelectTrigger>
                                <BlazorBlueprint.Primitives.Select.BbSelectContent class="w-full py-1 rounded-lg bg-popover border border-border shadow-md z-20 flex flex-col">
                                    @foreach (var role in this.ViewModel.RoleOptions)
                                    {
                                        <BlazorBlueprint.Primitives.Select.BbSelectItem Value="@role"
                                                                                        Text="@role.ToString()"
                                                                                        class="px-3 py-1.5 text-left text-xs leading-2xs text-foreground hover:bg-muted transition-colors cursor-pointer"/>
                                    }
                                </BlazorBlueprint.Primitives.Select.BbSelectContent>
                            </BlazorBlueprint.Primitives.Select.BbSelect>
                        </div>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnRemoveMember(member)"
                                  Class="shrink-0">
                            Remove
                        </BbButton>
                    </div>
                }
            </div>

            <p class="text-xs leading-2xs text-muted-foreground w-full">
                An Organization must keep at least one Organization Administrator. The Organization Administrator role takes effect only once the recipient accepts it.
            </p>
        </div>

        <div class="w-full p-5 sm:px-5.5 rounded-lg bg-card border border-border flex flex-col gap-3.5">
            <div class="flex items-center gap-2.5 w-full">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    PENDING INVITATIONS
                </span>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                @foreach (var invitation in this.ViewModel.PendingInvitations)
                {
                    <div class="flex flex-col sm:flex-row sm:items-center gap-3 py-2.25 w-full">
                        <span class="w-[280px] shrink-0 text-sm leading-xs font-medium text-foreground truncate min-w-0">
                            @(invitation.Email)
                        </span>

                        <BbBadge Variant="BadgeVariant.Secondary"
                                 Class="badge-role text-muted-foreground">
                            @(invitation.Role)
                        </BbBadge>

                        <span class="flex-1 text-xs leading-2xs font-normal text-muted-foreground truncate min-w-0">
                            @(invitation.StatusText)
                        </span>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnResendInvitation(invitation)"
                                  Class="shrink-0">
                            Resend
                        </BbButton>

                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Type="ButtonType.Button"
                                  OnClick="() => this.OnRevokeInvitation(invitation)"
                                  Class="shrink-0">
                            Revoke
                        </BbButton>
                    </div>
                }
            </div>

            <p class="text-xs leading-2xs text-muted-foreground w-full">
                An invitation admits an Account only after explicit acceptance, and expires automatically.
            </p>
        </div>

        <div class="w-full p-5 sm:px-5.5 rounded-lg bg-card border border-border flex flex-col gap-3.5">
            <div class="flex items-center gap-2.5 w-full">
                <span class="text-xs leading-2xs font-semibold uppercase tracking-wider text-muted-foreground flex-1">
                    SCOPE
                </span>
            </div>

            <div class="flex flex-col w-full divide-y divide-border">
                <div class="flex items-center justify-between gap-3 py-2 w-full">
                    <span class="text-sm leading-xs font-normal text-secondary-text truncate min-w-0">
                        Packages published under @(this.ViewModel.Organization.Scope)
                    </span>
                    <span class="text-sm leading-xs font-medium text-foreground shrink-0">
                        @(this.ViewModel.Organization.PackageCount)
                    </span>
                </div>
            </div>

            <p class="text-xs leading-2xs text-muted-foreground w-full">
                The organization cannot be deleted while its scope still holds packages.
            </p>
        </div>
    </div>
</div>