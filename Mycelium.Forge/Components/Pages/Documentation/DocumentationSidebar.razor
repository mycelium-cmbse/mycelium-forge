<aside class="w-full md:w-[280px] shrink-0 border-b md:border-b-0 md:border-r border-border p-4 md:p-6 flex flex-col gap-1 select-none overflow-y-auto">
    @foreach (var group in this.Groups)
    {
        <div @key="group.Title"
             class="flex flex-col gap-1 w-full mt-2 first:mt-0">
            <div class="flex items-center gap-1.5 px-1.5 py-2 w-full text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
                <LucideIcon Name="@(group.IconName)"
                            Size="12"
                            Class="text-muted-foreground shrink-0"/>
                <span>@(group.Title)</span>
            </div>

            <div class="flex flex-col gap-1 w-full">
                @foreach (var item in group.Items)
                {
                    <a @key="item.Title"
                       href="@(item.Href)"
                       class="@(GetNavItemClass(item))">
                        @(item.Title)
                    </a>
                }
            </div>
        </div>
    }
</aside>