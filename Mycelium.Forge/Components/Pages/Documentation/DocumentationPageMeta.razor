<div class="border-t border-border pt-4 flex flex-col gap-3.5 w-full @(this.Class)">
    <div class="flex items-center justify-between gap-2.5 w-full">
        <span class="text-sm leading-xs font-normal text-muted-foreground flex-1">
            Last updated @(this.LastUpdated)
        </span>
        <a href="https://github.com/mycelium-cmbse/mycelium-forge"
           target="_blank"
           rel="noopener noreferrer"
           class="text-sm leading-xs font-medium text-primary hover:underline shrink-0">
            Edit this page
        </a>
    </div>

    <div class="flex items-center gap-2.5 w-full">
        <span class="text-sm leading-xs font-normal text-muted-foreground flex-1">
            Was this page helpful?
        </span>
        @if (this.FeedbackGiven)
        {
            <span class="text-xs leading-2xs font-medium text-validated">
                Thank you for your feedback!
            </span>
        }
        else
        {
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Type="ButtonType.Button"
                      OnClick="@(() => this.SubmitFeedback(true))"
                      Class="h-7 px-3 text-xs leading-2xs font-medium text-secondary-text rounded-md">
                Yes
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Type="ButtonType.Button"
                      OnClick="@(() => this.SubmitFeedback(false))"
                      Class="h-7 px-3 text-xs leading-2xs font-medium text-secondary-text rounded-md">
                No
            </BbButton>
        }
    </div>
</div>
