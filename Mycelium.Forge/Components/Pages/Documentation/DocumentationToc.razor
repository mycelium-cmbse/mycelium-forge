<aside class="w-64 shrink-0 hidden xl:flex flex-col gap-2.5 py-12 px-4 bg-background select-none sticky top-0">
    <span class="text-2xs leading-3xs font-semibold uppercase tracking-wider text-muted-foreground">
        On this page
    </span>
    @foreach (var tocItem in this.Items)
    {
        <button type="button"
                @key="tocItem.Title"
                @onclick="@(() => this.OnItemClick(tocItem))"
                class="@(this.GetTocItemClass(tocItem)) text-left cursor-pointer bg-transparent border-0 p-0">
            @(tocItem.Title)
        </button>
    }
</aside>