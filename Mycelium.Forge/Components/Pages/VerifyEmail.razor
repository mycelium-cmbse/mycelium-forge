@using Mycelium.Forge.Common
@using Mycelium.Forge.Components.Common
@attribute [Route(PageRoutes.VerifyEmail)]
@rendermode InteractiveServer

<PageTitle>Verify Email &mdash; Mycelium Forge</PageTitle>

<div class="w-full bg-body-bg min-h-[calc(100vh-3.5rem)] flex flex-col items-center justify-center py-10 px-4 select-none">
    <div class="w-full max-w-[440px] p-8 sm:p-[34px_32px] rounded-[14px] bg-card border border-border shadow-[0px_6px_20px_-4px_rgba(15,23,41,0.06)] dark:shadow-none flex flex-col items-center gap-4.5">
        <ForgeLogo />

        <div class="w-13 h-5.5 rounded-full bg-[#FAECE3] dark:bg-amber-950/40 flex items-center justify-center">
            <LucideIcon Name="mail"
                        Size="14"
                        Class="text-primary" />
        </div>

        <div class="flex flex-col items-center gap-1 w-full text-center">
            <h1 class="text-xl sm:text-2xl leading-xl font-semibold text-foreground tracking-tight">
                Verify your email
            </h1>
            <p class="text-sm leading-xs font-normal text-muted-foreground">
                We sent a verification link to <span class="font-medium text-foreground">@(this.ViewModel.Email)</span>. Open it to activate publishing on your account.
            </p>
        </div>

        <div class="w-full p-3 px-3.5 rounded-lg bg-body-bg dark:bg-card border border-border flex flex-col gap-1.5">
            <div class="flex items-center justify-between gap-2 w-full">
                <span class="text-xs leading-2xs font-normal text-secondary-text flex-1 truncate">
                    Account created
                </span>
                <span class="text-xs leading-2xs font-medium text-[#218C5C] dark:text-emerald-400 shrink-0">
                    Done
                </span>
            </div>
            <div class="flex items-center justify-between gap-2 w-full">
                <span class="text-xs leading-2xs font-normal text-secondary-text flex-1 truncate">
                    Email verified
                </span>
                <span class="text-xs leading-2xs font-medium text-[#B2730D] dark:text-amber-400 shrink-0">
                    Pending
                </span>
            </div>
            <div class="flex items-center justify-between gap-2 w-full">
                <span class="text-xs leading-2xs font-normal text-muted-foreground flex-1 truncate">
                    Publishing enabled
                </span>
                <span class="text-xs leading-2xs font-medium text-muted-foreground shrink-0">
                    Locked
                </span>
            </div>
        </div>

        <BbButton Variant="ButtonVariant.Default"
                  Type="ButtonType.Button"
                  OnClick="@(this.OnSendEmail)"
                  Disabled="@(this.ViewModel.IsSending)"
                  Class="w-full h-8 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground font-medium text-sm leading-xs flex items-center justify-center transition-colors cursor-pointer disabled:opacity-50">
            Resend verification email
        </BbButton>

        <div class="flex items-center gap-1.5 text-xs leading-2xs font-normal text-muted-foreground pt-0.5">
            <span>Wrong address?</span>
            <a href="@PageRoutes.AccountSettings"
               class="text-primary font-medium hover:underline">
                Change it
            </a>
        </div>
    </div>
</div>
