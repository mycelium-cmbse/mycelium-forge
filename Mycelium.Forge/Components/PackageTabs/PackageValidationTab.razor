@if (this.Report != null && this.Report.Checks != null && this.Report.Checks.Count > 0)
{
    <div class="w-full p-6 rounded-lg bg-card border border-border flex flex-col gap-3 @(this.Class)">
        <div class="w-full p-3 px-4 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/60 flex items-center gap-2.5">
            <LucideIcon Name="check-circle-2"
                        Size="18"
                        Class="text-emerald-700 dark:text-emerald-400 shrink-0"/>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="text-base leading-17 font-semibold text-emerald-800 dark:text-emerald-300">
                    @(this.Report.Title)
                </span>
                <span class="text-xs leading-2xs text-slate-700 dark:text-slate-300">
                    @(this.Report.Description)
                </span>
            </div>
            <span class="text-md leading-sm font-semibold text-emerald-700 dark:text-emerald-400 shrink-0">
                @(this.Report.Score)
            </span>
        </div>

        <div class="w-full rounded-lg bg-card border border-border flex flex-col divide-y divide-border overflow-hidden mt-1">
            @foreach (var check in this.Report.Checks)
            {
                <div class="px-4 py-3 flex items-center gap-2.5">
                    <LucideIcon Name="check"
                                Size="16"
                                Class="text-green-600 dark:text-green-400 shrink-0"/>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="text-sm leading-xs font-semibold text-foreground">
                            @(check.Title)
                        </span>
                        <span class="text-xs leading-2xs text-muted-foreground">
                            @(check.Detail)
                        </span>
                    </div>
                    <span class="text-xs leading-2xs font-medium text-green-600 dark:text-green-400 shrink-0">
                        @(check.StatusText)
                    </span>
                </div>
            }
        </div>
    </div>
}