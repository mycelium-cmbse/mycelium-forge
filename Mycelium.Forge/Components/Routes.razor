@*
    Routing for the Forge web interface. Unmatched routes are handled by the status-code-pages
    re-execution configured in Program.cs, which re-issues the request against /not-found.
 *@

@using Microsoft.AspNetCore.Components.Authorization
@using Mycelium.Forge.Components.Common

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <SignInRequired />
                </NotAuthorized>
            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="@routeData"
                             Selector="h1"/>
        </Found>
    </Router>
</CascadingAuthenticationState>

<BbProviders />
