{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ForgeInitialization": {
    "RetryIntervalSeconds": 5
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 10,
    "LeaseDurationSeconds": 30,
    "BaseRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300,
    "ImmediateRetryCount": 2
  },
  "ShortcutCommands": {
    "search": "k"
  },
  "MaximumUploadFileSizeInMB": 250,
  "AllowedHosts": "*"
}
